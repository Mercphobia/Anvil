#!/system/bin/sh
# ANVIL - neofetch banner (embedded shell)
if [ -t 1 ]; then
  B="\033[1m"; ACC="\033[38;5;111m"; OK="\033[38;5;114m"; MUT="\033[38;5;245m"; R="\033[0m"
else
  B=""; ACC=""; OK=""; MUT=""; R=""
fi
LOGO='              _______
         ____/  _____\____
        /    \ /     \    \
       /  A  \|  ___  |/   \
      |   __  \ |___|  |    |
      |  |  |  |     |  |   |
       \_|__|_/ |_____| \_|_/
        /___________________\
        \___/           \___/
'
prefix="${PREFIX:-/data/data/com.termux/files/usr}"
kernel="$(uname -r 2>/dev/null || echo '?')"
arch="$(uname -m 2>/dev/null || echo 'aarch64')"
uptime="$(uptime 2>/dev/null | sed 's/.*up //; s/,.*//' || echo '?')"
sh_name="$(basename "${SHELL:-sh}")"
pkg_count="$(ls "$prefix/bin" 2>/dev/null | wc -l | tr -d ' ')"
android_ver="$(getprop ro.build.version.release 2>/dev/null || echo '?')"
device="$(getprop ro.product.model 2>/dev/null || echo 'Android')"

printf '%b' "${ACC}${LOGO}${R}${MUT}     ~ forged on device ~${R}\n\n"
printf '%b' "${B}${ACC}anvil${R}${MUT}@${R}${B}${ACC}android${R}\n${MUT}-----------------${R}\n"
printf '%b' "${B}OS${R}: Anvil ADE on Android ${android_ver} (${arch})\n"
printf '%b' "${B}Host${R}: ${device}\n${B}Kernel${R}: ${kernel}\n${B}Uptime${R}: ${uptime}\n"
printf '%b' "${B}Shell${R}: ${sh_name} (embedded env)\n${B}Packages${R}: ${pkg_count} binaries\n"
printf '%b' "${OK}Build${R}: aapt2 > ecj > d8 > apksig (in-process)\n"
printf '%b' "${MUT}anvil.dev - the agentic dev env in your pocket${R}\n"
